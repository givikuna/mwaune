{
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devPath": "http://localhost:5173",
        "distDir": "../dist"
    },
    "package": {
        "productName": "mwaune",
        "version": "0.1.0"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "fs": {
                "scope": ["$HOME/.mwaune/**", "$HOME/**"],
                "all": true
            },
            "dialog": {
                "open": true
            },
            "shell": {
                "open": false
            }
        },
        "bundle": {
            "active": true,
            "identifier": "com.mwaune.app",
            "icon": [
                "icons/32x32.png",
                "icons/128x128.png",
                "icons/128x128@2x.png",
                "icons/icon.icns",
                "icons/icon.ico"
            ],
            "resources": [],
            "copyright": "",
            "category": "Utility",
            "shortDescription": "Book and paper management",
            "longDescription": "",
            "deb": {
                "depends": []
            },
            "macOS": {
                "frameworks": [],
                "minimumSystemVersion": "",
                "useBootstrapper": false,
                "exceptionDomain": ""
            },
            "windows": {
                "certificateThumbprint": null,
                "digestAlgorithm": "sha256",
                "timestampUrl": "",
                "webviewInstallMode": {
                    "type": "downloadBootstrapper",
                    "silent": false
                }
            }
        },
        "updater": {
            "active": false
        },
        "windows": [
            {
                "title": "mwaune",
                "width": 1200,
                "height": 800,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "transparent": false
            }
        ]
    }
}
